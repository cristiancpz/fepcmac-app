  },
  "dependencies": {
    "expo": "^51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-webview": "13.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  }
}
